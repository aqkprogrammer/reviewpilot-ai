# =============================================================================
# ReviewPilot AI — environment configuration
# Copy to `.env` (repo root). apps/api reads both apps/api/.env and ../../.env.
# NEVER commit real secrets. Production refuses to boot with dev defaults
# (see apps/api/app/core/config.py → Settings._validate_production).
# =============================================================================

# ---- Runtime -----------------------------------------------------------------
ENVIRONMENT=development            # development | test | staging | production
DEBUG=false
# Demo mode: seeded sample data + simulated (clearly labelled) messaging & payments.
# MUST be false in production.
DEMO_MODE=true

# ---- Core infrastructure -----------------------------------------------------
DATABASE_URL=postgresql+asyncpg://reviewpilot:reviewpilot@localhost:5432/reviewpilot
REDIS_URL=redis://localhost:6379/0
# Development only: run background jobs in-process when Redis is unreachable.
INLINE_JOBS_FALLBACK=true

# ---- Secrets -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-dev-only-secret-key-at-least-32-chars
JWT_SECRET=change-me-dev-only-jwt-secret-at-least-32-chars
# Fernet key for encrypting integration tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes previously stored tokens unreadable (users must reconnect integrations).
# Leave commented in development to use the built-in dev key; REQUIRED in production.
# ENCRYPTION_KEY=

# ---- Sessions & cookies --------------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_TTL_DAYS_SHORT=1      # when "remember me" is unchecked
COOKIE_SECURE=false                 # true in production (HTTPS)
# COOKIE_DOMAIN=.reviewpilot.ai      # leave unset locally; e.g. .reviewpilot.ai to share across app./admin. subdomains
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---- URLs ----------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000  # the web origin; OAuth callbacks & tracked links use it
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000  # comma-separated

# ---- Google (Sign-In + Business Profile API) -----------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults: {FRONTEND_URL}/api/v1/auth/google/callback and {FRONTEND_URL}/api/v1/integrations/google/callback
GOOGLE_REDIRECT_URI=
GOOGLE_GBP_REDIRECT_URI=
# Local/E2E-only mock Google identity provider. Refused in production.
OAUTH_MOCK_ENABLED=false

# ---- OpenAI ----------------------------------------------------------------------
# Without a key, AI features use an offline heuristic generator labelled "heuristic".
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MONTHLY_REQUEST_LIMIT_DEFAULT=500

# ---- WhatsApp Cloud API (platform-level fallback; orgs can connect their own) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=               # verifies X-Hub-Signature-256 on webhooks
WHATSAPP_VERIFY_TOKEN=             # echoed during Meta webhook verification
WHATSAPP_API_VERSION=v21.0

# ---- Email (Resend) ----------------------------------------------------------------
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=             # whsec_... (Svix signing secret)
EMAIL_FROM="ReviewPilot AI <no-reply@reviewpilot.ai>"

# ---- SMS (Twilio adapter; use a DLT-registered sender in India) ----------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Payments --------------------------------------------------------------------
DEFAULT_PAYMENT_PROVIDER=razorpay  # razorpay | stripe | mock (mock only works with DEMO_MODE=true)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
TRIAL_DAYS=14
GRACE_PERIOD_DAYS=7
# Supplier details printed on invoices. Without COMPANY_GSTIN invoices are plain "Invoice"
# documents, not GST tax invoices. Same-state buyers get CGST+SGST, others IGST.
COMPANY_LEGAL_NAME=ReviewPilot AI
# COMPANY_GSTIN=27ABCDE1234F1Z5
# COMPANY_ADDRESS=Registered office address
# COMPANY_STATE_CODE=27
# INVOICE_SAC_CODE=   # confirm the SAC with your tax adviser

# ---- File storage (S3-compatible; local disk when unset) -----------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=ap-south-1
S3_ENDPOINT_URL=                   # e.g. Cloudflare R2 / MinIO endpoint
LOCAL_STORAGE_DIR=storage
MAX_UPLOAD_BYTES=2097152

# ---- Error monitoring (optional) -------------------------------------------------
# Browser + API errors always land in error_events (Super Admin -> System health).
# Set SENTRY_DSN to also forward API errors to Sentry (or a self-hosted GlitchTip).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0        # 0..1; 0 = errors only, no performance tracing
SENTRY_ENVIRONMENT=                # defaults to ENVIRONMENT
SENTRY_RELEASE=                    # defaults to RENDER_GIT_COMMIT / GIT_SHA when set

# ---- Super Admin bootstrap -------------------------------------------------------
# python -m app.cli create-super-admin --email $SUPER_ADMIN_EMAIL --secret $SUPER_ADMIN_BOOTSTRAP_SECRET
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_BOOTSTRAP_SECRET=      # 16+ chars; rotate after use

# ---- Development seed users (seed-demo only; never used in production) --------
SEED_PASSWORD_OWNER=Owner@12345
SEED_PASSWORD_ADMIN=Admin@12345
SEED_PASSWORD_STAFF=Staff@12345
SEED_PASSWORD_SUPER_ADMIN=SuperAdmin@12345
